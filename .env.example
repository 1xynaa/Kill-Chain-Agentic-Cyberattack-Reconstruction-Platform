# Backend provider configuration example
# Copy to .env.local; never commit real credentials.
KILLCHAIN_WORKSPACE_ROOT=/tmp/killchain-workspaces
KILLCHAIN_MAX_FILE_SIZE=536870912
KILLCHAIN_MAX_TOOL_OUTPUT=20000
KILLCHAIN_TOOL_TIMEOUT=30
KILLCHAIN_MAX_TOOL_CALLS=20
KILLCHAIN_ALLOW_NETWORK_TOOLS=false
