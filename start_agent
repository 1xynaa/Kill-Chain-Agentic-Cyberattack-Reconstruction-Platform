#!/usr/bin/env bash
set -Eeuo pipefail

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
BACKEND_HOST="${BACKEND_HOST:-127.0.0.1}"
BACKEND_PORT="${BACKEND_PORT:-8000}"
FRONTEND_HOST="${FRONTEND_HOST:-127.0.0.1}"
FRONTEND_PORT="${FRONTEND_PORT:-5173}"
LOG_DIR="${ROOT}/.runtime"
BACKEND_LOG="${LOG_DIR}/backend.log"
FRONTEND_LOG="${LOG_DIR}/frontend.log"
BACKEND_PID=""
FRONTEND_PID=""

mkdir -p "$LOG_DIR"

cleanup() {
  trap - EXIT INT TERM
  [[ -n "$FRONTEND_PID" ]] && kill "$FRONTEND_PID" 2>/dev/null || true
  [[ -n "$BACKEND_PID" ]] && kill "$BACKEND_PID" 2>/dev/null || true
  wait "$FRONTEND_PID" "$BACKEND_PID" 2>/dev/null || true
}
trap cleanup EXIT INT TERM

wait_for_url() {
  local url="$1" name="$2"
  for _ in {1..30}; do
    if curl -fsS --max-time 2 "$url" >/dev/null 2>&1; then
      printf '%s\n' "$name: ready"
      return 0
    fi
    sleep 1
  done
  printf '%s\n' "$name: failed to become ready; see %s" "$3" >&2
  return 1
}

if curl -fsS --max-time 2 "http://${BACKEND_HOST}:${BACKEND_PORT}/health" >/dev/null 2>&1; then
  echo "Backend: reusing healthy service at http://${BACKEND_HOST}:${BACKEND_PORT}"
else
  echo "Starting backend..."
  (
    cd "$ROOT"
    exec python3 -m uvicorn backend.app.main:app --host "$BACKEND_HOST" --port "$BACKEND_PORT"
  ) >"$BACKEND_LOG" 2>&1 &
  BACKEND_PID=$!
  wait_for_url "http://${BACKEND_HOST}:${BACKEND_PORT}/health" "Backend" "$BACKEND_LOG"
fi

if curl -fsS --max-time 2 "http://${FRONTEND_HOST}:${FRONTEND_PORT}/" >/dev/null 2>&1; then
  echo "Frontend: reusing healthy service at http://${FRONTEND_HOST}:${FRONTEND_PORT}"
else
  echo "Starting frontend..."
  (
    cd "$ROOT/frontend"
    exec npm run dev -- --host "$FRONTEND_HOST" --port "$FRONTEND_PORT"
  ) >"$FRONTEND_LOG" 2>&1 &
  FRONTEND_PID=$!
  wait_for_url "http://${FRONTEND_HOST}:${FRONTEND_PORT}/" "Frontend" "$FRONTEND_LOG"
fi

if curl -fsS --max-time 3 "http://${FRONTEND_HOST}:${FRONTEND_PORT}/api/health" >/dev/null 2>&1; then
  echo "Proxy: ready"
else
  echo "Proxy: unavailable at /api/health; inspect $FRONTEND_LOG" >&2
fi

echo
echo "Kill-Chain Agent is running."
echo "Open: http://${FRONTEND_HOST}:${FRONTEND_PORT}/"
echo "Backend: http://${BACKEND_HOST}:${BACKEND_PORT}/"
echo "Logs: $LOG_DIR"
echo "Press Ctrl-C to stop processes started by this script."

while true; do
  if [[ -n "$BACKEND_PID" ]] && ! kill -0 "$BACKEND_PID" 2>/dev/null; then
    echo "Backend exited; see $BACKEND_LOG" >&2
    exit 1
  fi
  if [[ -n "$FRONTEND_PID" ]] && ! kill -0 "$FRONTEND_PID" 2>/dev/null; then
    echo "Frontend exited; see $FRONTEND_LOG" >&2
    exit 1
  fi
  sleep 2
done
